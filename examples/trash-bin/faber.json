{
  "schema": 2,
  "revision": 11,
  "name": "Hexagonal trash bin",
  "params": {
    "band_bot": "45",
    "band_top": "75",
    "bottom_r": "top_r - height * tan(draft_deg) / cos(30)",
    "cell_box_h": "8 * pitch_z + 2 * cell_r + 4",
    "cell_margin": "18",
    "cell_r": "cell_size / sqrt(3)",
    "cell_size": "22",
    "clip_half": "flat_half - cell_margin",
    "corner_r": "12",
    "draft_deg": "3",
    "field_bot": "floor_z + band_bot",
    "field_h": "field_top - field_bot",
    "field_mid": "(field_bot + field_top) / 2",
    "field_top": "top_z - band_top",
    "flat_half": "bottom_r / 2 - wall / (2 * cos(30)) - inner_corner_r * tan(30)",
    "floor_r": "8",
    "floor_t": "4",
    "floor_z": "foot_h + floor_t",
    "foot_d": "10",
    "foot_h": "5",
    "foot_pos": "100",
    "foot_r": "foot_d / 2",
    "grip_drop": "40",
    "grip_h": "25",
    "grip_w": "90",
    "grip_z": "top_z - grip_drop",
    "height": "340",
    "in_r": "top_r - wall / cos(30)",
    "inner_corner_r": "10",
    "lip_h": "8",
    "lip_out": "6",
    "lip_r": "top_r + lip_out / cos(30)",
    "lip_z": "top_z - lip_h",
    "pitch_x": "cell_size + web",
    "pitch_z": "pitch_x * sqrt(3) / 2",
    "top_r": "150",
    "top_z": "foot_h + height",
    "vent_d": "8",
    "vent_z": "foot_h + 30",
    "wall": "2.4",
    "web": "5"
  }
}
